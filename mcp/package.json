{
  "name": "@rockbottom/mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "rockbottom-mcp": "dist/src/index.js"
  },
  "scripts": {
    "dev": "MCP_TRANSPORT=sse tsx watch --ignore ../node_modules --ignore ../client --ignore ../admin src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "rule-agent": "tsx examples/rule-agent.ts",
    "model-agent": "tsx examples/model-agent.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
