{
  "name": "@rockbottom/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --ignore ../node_modules --ignore ../client --ignore ../admin src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate:sqlite": "prisma generate --schema prisma/sqlite.prisma",
    "prisma:generate:postgres": "prisma generate --schema prisma/postgres.prisma",
    "db:migrate": "tsx src/migrate.ts",
    "db:import": "tsx src/import-save.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.3.6",
    "@rockbottom/shared": "workspace:*",
    "ajv": "^8.20.0",
    "fastify": "^5.12.8",
    "ws": "^8.22.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@prisma/client": "^6.19.3",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "@types/pg": "^8.23.1"
  }
}
